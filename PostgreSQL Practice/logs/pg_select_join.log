SELECT s.name AS ship, COUNT(*) AS crew_count
FROM ships s
JOIN crew c ON c.ship_id = s.id
GROUP BY s.name;
   ship   | crew_count 
----------+------------
 Nostromo |          5
 Aurora   |          5
